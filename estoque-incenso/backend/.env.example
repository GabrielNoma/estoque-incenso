DATABASE_URL=postgresql://user:pass@host:5432/dbname
PORT=3000
LOG_LEVEL=info
NODE_ENV=development
PEDIDO_BOT_URL=http://127.0.0.1:8000
PEDIDO_BOT_TIMEOUT_MS=240000
# Robô dormindo (plano gratuito do Render): tentativas e espera entre elas (padrão 20 x 5000 ms ≈ 100 s).
# PEDIDO_BOT_TENTATIVAS=20
# PEDIDO_BOT_ESPERA_MS=5000
# Chave do robô de pedidos (escopos conversa e modelo). SÓ no ambiente do servidor; nunca no repositório.
# PEDIDO_BOT_API_KEY=
