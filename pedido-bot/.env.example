# Copy to .env and fill in the keys. Never commit real keys.
# Load with:  set -a && source .env && set +a

# --- Database (required) ---------------------------------------------------------------
DATABASE_URL=postgresql://pedido:pedido@localhost:5434/pedido

# --- Language model: anthropic | openai_compatible -------------------------------------
LLM_PROVIDER=anthropic
# anthropic:
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5-5
# openai_compatible (for example Ollama's hosted service):
# LLM_BASE_URL=https://ollama.com/v1
# LLM_MODEL=
# LLM_API_KEY=
# LLM_STRUCTURED_METHOD=json_schema   # or function_calling / json_mode

# --- Memória silenciosa de apelidos (opcional; sem EMBED_* o bot funciona sem memória) -------------
# EMBED_BASE_URL=http://localhost:11434/v1
# EMBED_MODEL=bge-m3
# EMBED_API_KEY=                       # um Ollama local ignora a chave
# EMBED_DIMENSIONS=1024                # fixo quando a tabela de apelidos é criada
# EMBED_TIMEOUT_SECONDS=5
# EMBED_SIMILARITY=0.92                # similaridade mínima para um apelido valer

# --- Guardrails (todos opcionais; valores padrão) --------------------------------------------------
# MAX_LINHAS=50
# MAX_TEXTO_LINHA=120
# MAX_MENSAGEM=2000
# LIMITE_MSG_POR_MINUTO=20
# MAX_QTD_PRODUTO=1000

# --- Modelo da planilha (opcional) -----------------------------------------------------------------
# MAX_MODELO_MB=5                      # tamanho máximo de um modelo importado

# --- Modelo de linguagem lento (padrão 180 s; um pedido grande leva ~2 min no Ollama local) ---------
# LLM_TIMEOUT_SECONDS=180

# --- Produção e acesso (feature 006) -----------------------------------------------------------------
# ENVIRONMENT=producao                 # liga as regras de produção (sem página de teste, sem /docs, exige chaves)
# PORT=10000                           # o Render define sozinho
# API_KEYS=estoque:conversa+modelo:TROQUE-POR-UMA-CHAVE-DE-32-OU-MAIS-CARACTERES,whatsapp:conversa:OUTRA-CHAVE-LONGA
# MIGRATE_ON_START=false               # só para uso local: aplica migrações pendentes ao iniciar
# LLM_MAX_TOKENS=4096                  # tamanho máximo da resposta de cada chamada ao modelo
# LIMITE_DIARIO_CONVERSA=200           # mensagens por conversa por dia
# LIMITE_REQ_POR_CHAVE=120             # requisições por chave por minuto
# MAX_LLM_CONCORRENTES=4               # chamadas simultâneas ao modelo de linguagem
# ESPERA_LLM_SEGUNDOS=20               # quanto uma mensagem espera por uma vaga
# MAX_CORPO_MENSAGEM_KB=64             # tamanho máximo do corpo de uma mensagem
# EMBED_SEND_DIMENSIONS=false          # true: envia EMBED_DIMENSIONS ao serviço de embeddings
